{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pherls",
  "account_id": "82b6eed25b499085f51f718f8190b4d2",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  "upload_source_maps": true,
  "triggers": {
    "crons": ["0 12 * * 1"]
  },
  // "vars": {
  //   "GEMINI_MODELS": "gemini-3.8-flash,gemini-3.5-flash-lite",
  //   "REASONING_PROFILES": "{\"fast\":{\"models\":[\"gemini-3.5-flash-lite\",\"gemini-3.8-flash\"],\"temperature\":0.25,\"maxOutputTokens\":450,\"thinkingBudget\":0,\"thinkingLevel\":\"minimal\"},\"default\":{\"models\":[\"gemini-3.8-flash\",\"gemini-3.5-flash-lite\"],\"temperature\":0.3,\"maxOutputTokens\":600,\"thinkingBudget\":512,\"thinkingLevel\":\"low\"},\"high\":{\"models\":[\"gemini-3.8-flash\",\"gemini-3.5-flash-lite\"],\"temperature\":0.3,\"maxOutputTokens\":900,\"thinkingBudget\":2048,\"thinkingLevel\":\"medium\"}}"
  // },
  "kv_namespaces": [
    {
      "binding": "INBOX",
      "id": "9513e6cd5e7f46feb1545faf27d48f1c"
    }
  ],
  "d1_databases": [
    {
      "binding": "QUESTIONS",
      "database_name": "pherls-questions",
      "database_id": "c0fca173-c1a0-4934-973c-28e32fd6a64f",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "6101",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "CHAT_HIGH_LIMIT",
      "namespace_id": "6103",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "6102",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/llms.txt",
      "/robots.txt",
      "/sitemap.xml",
      "/cv.md",
      "/cv.json",
      "/.well-known/*",
      "/studio",
      "/studio/*",
      "/admin",
      "/admin/*"
    ]
  },
  "routes": [
    { "pattern": "pherls.dev", "custom_domain": true }
  ],
  "previews": {
    "vars": {
      "GEMINI_MODELS": "gemini-3.8-flash,gemini-3.5-flash-lite",
      "REASONING_PROFILES": "{\"fast\":{\"models\":[\"gemini-3.5-flash-lite\",\"gemini-3.8-flash\"],\"temperature\":0.25,\"maxOutputTokens\":450,\"thinkingBudget\":0,\"thinkingLevel\":\"minimal\"},\"default\":{\"models\":[\"gemini-3.8-flash\",\"gemini-3.5-flash-lite\"],\"temperature\":0.3,\"maxOutputTokens\":600,\"thinkingBudget\":512,\"thinkingLevel\":\"low\"},\"high\":{\"models\":[\"gemini-3.8-flash\",\"gemini-3.5-flash-lite\"],\"temperature\":0.3,\"maxOutputTokens\":900,\"thinkingBudget\":2048,\"thinkingLevel\":\"medium\"}}"
    },
    "kv_namespaces": [
      {
        "binding": "INBOX",
        "id": "2caac2a53908405e8b365bb10dd90ed3"
      }
    ],
    "d1_databases": [
      {
        "binding": "QUESTIONS",
        "database_name": "pherls-questions-preview",
        "database_id": "08452bf4-552a-459a-a1b7-0cad99faa2d7",
        "migrations_dir": "migrations"
      }
    ],
    "ratelimits": [
      {
        "name": "CHAT_LIMIT",
        "namespace_id": "6201",
        "simple": { "limit": 20, "period": 60 }
      },
      {
        "name": "CHAT_HIGH_LIMIT",
        "namespace_id": "6203",
        "simple": { "limit": 6, "period": 60 }
      },
      {
        "name": "CONTACT_LIMIT",
        "namespace_id": "6202",
        "simple": { "limit": 8, "period": 60 }
      }
    ]
  }
}
